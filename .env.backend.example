# Backend Environment Variables Template
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# MySQL Database (Hostinger)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Supabase Cloud Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="ECOM WITH SAMI"

# Video Streaming CDN (Bunny.net)
BUNNY_API_KEY=your_bunny_api_key
BUNNY_LIBRARY_ID=your_library_id
BUNNY_CDN_HOSTNAME=your_cdn_hostname

# Meta Conversions API
META_ACCESS_TOKEN=your_meta_token_here
META_PIXEL_ID=your_pixel_id_here

# TikTok Server Events API
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
TIKTOK_PIXEL_ID=your_tiktok_pixel_here
