<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Direct all /api/* requests to PHP API Gateway
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # 2. Allow existing files and directories to load directly (CSS, JS, Images, HTML)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Support subfolder index.html (e.g., /enrollment -> /enrollment/index.html, /admin -> /admin/index.html)
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 4. Fallback to main index.html for client-side routing
    RewriteRule ^ index.html [L]
</IfModule>
